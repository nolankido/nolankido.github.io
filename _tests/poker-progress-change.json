    "poker/study/index.html": {
      "old_sha256": "c6438f22f4111bb7c70789258d562043be7d6c4a190e1fff7027c8b9278dce0f",
      "new_sha256": "4d10cd221816e8819a141bc18e25547d8d3ab16427b5054d43dc9741eddc4708",
      "edits": [
        {
          "start": 2969,
          "end": 3117,
          "old": "",
          "new": "  <link rel=\"stylesheet\" href=\"/assets/poker-progress.css?v=eaea29052803\">\n  <script defer src=\"/assets/poker-progress.js?v=17477d4879d2\"></script>\n"
        },
        {
          "start": 3951,
          "end": 3952,
          "old": "2",
